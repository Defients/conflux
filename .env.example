# Conflux Circuit — Environment Variables
# Copy this file to .env and fill in your production values before running `npm run build`.

# ── Colyseus server URL (REQUIRED for online multiplayer) ──────────────────
# Point this at your deployed Colyseus server (e.g. Railway, Render, Fly.io).
# The server in /server cannot run on Neocities — it needs a Node.js host.
VITE_SERVER_URL=wss://your-colyseus-server.example.com

# ── Firebase (REQUIRED for online auth & profile sync) ────────────────────
# Create a Firebase project at https://console.firebase.google.com/
# Enable Anonymous Authentication and Firestore, then copy the web app config here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Gemini API key (optional, for AI features if applicable) ───────────────
GEMINI_API_KEY=
