# Conflux Circuit Server — Environment Variables
#
# Copy this file to .env and fill in the values.
# On Render, set these in the dashboard or via render.yaml.

# ─── Core ────────────────────────────────────────────────────────────────────
# Port the Colyseus server listens on (default: 2567)
PORT=2567

# Node environment (development | production)
NODE_ENV=production

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# When unset, all origins are permitted (local dev only).
# Example: https://confluxcircuit.com,https://www.confluxcircuit.com
ALLOWED_ORIGINS=

# ─── Firebase Admin (optional — for server-side profile/leaderboard writes) ──
# Path to the Firebase service account JSON file.
# If unset, server runs without Firebase integration.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Build Metadata (auto-injected by CI/deployment platform) ────────────────
# Git commit SHA — used in diagnostics endpoint
# RENDER_GIT_COMMIT is auto-injected by Render
GIT_COMMIT=
SOURCE_VERSION=

# App version (defaults to package.json version)
APP_VERSION=

# Build timestamp (ISO 8601)
BUILD_TIMESTAMP=
