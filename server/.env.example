# Conflux Circuit Server — Environment Variables
#
# Copy this file to .env and fill in the values.
# On Render, set these in the dashboard or via render.yaml.

# ─── Core ────────────────────────────────────────────────────────────────────
# Port the Colyseus server listens on (default: 2567)
PORT=2567

# Node environment (development | production)
NODE_ENV=production

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# When unset, all origins are permitted (local dev only).
# Example: https://confluxcircuit.com,https://www.confluxcircuit.com
ALLOWED_ORIGINS=

# ─── Firebase Admin (REQUIRED for online auth in production) ──────────────────
# The server verifies Firebase ID tokens on every room join (onAuth).
# Without valid credentials, all joins are rejected with "onAuth failed".
#
# Credential resolution order (any one is sufficient):
#   1. FIREBASE_SERVICE_ACCOUNT_PATH — path to a service account JSON file.
#   2. GOOGLE_APPLICATION_CREDENTIALS — Google's standard ADC variable
#      (also a path to a service account JSON).
#   3. FIREBASE_SERVICE_ACCOUNT_JSON — the service account JSON pasted inline
#      (useful on hosts without secret-file mounts, e.g. Render free tier).
#   4. Application Default Credentials — automatic on GCP/Cloud Run.
#
# Download a service account JSON from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key.
# On Render: either add a Secret File and set the path, or paste the JSON
# directly into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Auth bypass (development ONLY — never use in production) ─────────────────
# When set to 1, the server skips Firebase token verification and assigns all
# clients the UID "dev-user". Useful for local development without Firebase.
# In production (NODE_ENV=production), the server will REFUSE TO START without
# credentials unless this is set — failing fast is safer than silently rejecting
# every join.
FIREBASE_AUTH_DISABLED=

# ─── Build Metadata (auto-injected by CI/deployment platform) ────────────────
# Git commit SHA — used in diagnostics endpoint
# RENDER_GIT_COMMIT is auto-injected by Render
GIT_COMMIT=
SOURCE_VERSION=

# App version (defaults to package.json version)
APP_VERSION=

# Build timestamp (ISO 8601)
BUILD_TIMESTAMP=
